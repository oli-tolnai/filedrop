# Másold .env néven csak a Dell szerveren, és használj hosszú, véletlen értéket.
FILEDROP_SETUP_TOKEN=csereld-le-egy-hosszu-veletlen-beallitasi-kodra
FILEDROP_BIND_ADDRESS=192.168.0.34
FILEDROP_PORT=8090
# A Tailscale adminfelületén létrehozott, nem ephemeral auth key.
# Ezt csak a Dell szerver .env fájljába írd be, GitHubra ne kerüljön.
FILEDROP_TS_AUTHKEY=add-your-tailscale-auth-key-here
# A külön filedrop-public Cloudflare Tunnel tokenje. Soha ne commitold.
FILEDROP_CF_TUNNEL_TOKEN=add-your-cloudflare-tunnel-token-here
FILEDROP_PUBLIC_GATEWAY_PORT=8092
FILEDROP_PUBLIC_BASE_URL=https://drop.tolnaioli.hu
