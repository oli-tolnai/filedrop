{
  "name": "FileDrop – otthoni fájlátadás",
  "short_name": "FileDrop",
  "description": "Gyors fájlátadás az otthoni hálózaton.",
  "lang": "hu",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f8fa",
  "theme_color": "#1769aa",
  "icons": [
    {
      "src": "/icons/filedrop-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": ["*/*"]
        }
      ]
    }
  }
}
